(() => {
    "use strict";

    const stage = document.getElementById("vehicle3dStage");

    if (!stage) {
        console.warn("AIM002: vehicle3dStage not found.");
        return;
    }

    /*
     * AIM002 Lightweight Vehicle Inspection Viewer
     *
     * No Three.js.
     * No CDN.
     * No external dependencies.
     *
     * Uses Canvas + a small custom 3D projection system.
     */

    // ------------------------------------------------------------
    // Canvas
    // ------------------------------------------------------------

    const canvas = document.createElement("canvas");
    canvas.className = "aim002-native-vehicle-canvas";
    canvas.setAttribute("aria-label", "Interactive AIM002 vehicle inspection model");

    const existingLoading = stage.querySelector(".vehicle-loading");

    if (existingLoading) {
        existingLoading.remove();
    }

    stage.insertBefore(canvas, stage.firstChild);

    const ctx = canvas.getContext("2d", {
        alpha: true,
        antialias: true
    });

    if (!ctx) {
        console.error("AIM002: Canvas is not supported.");
        return;
    }

    // ------------------------------------------------------------
    // State
    // ------------------------------------------------------------

    const state = {
        yaw: -0.55,
        pitch: 0.12,
        zoom: 1,
        targetYaw: -0.55,
        targetPitch: 0.12,
        targetZoom: 1,

        autoRotate: true,
        dragging: false,

        pointerX: 0,
        pointerY: 0,

        selectedPoint: null,

        width: 1000,
        height: 600,
        dpr: Math.min(window.devicePixelRatio || 1, 2)
    };

    const views = {
        home: {
            yaw: -0.55,
            pitch: 0.12,
            zoom: 1
        },
        front: {
            yaw: 0,
            pitch: 0.08,
            zoom: 1.08
        },
        side: {
            yaw: Math.PI / 2,
            pitch: 0.08,
            zoom: 1.08
        },
        rear: {
            yaw: Math.PI,
            pitch: 0.08,
            zoom: 1.08
        },
        top: {
            yaw: -0.55,
            pitch: 0.82,
            zoom: 0.92
        }
    };

    // ------------------------------------------------------------
    // Inspection points
    // ------------------------------------------------------------

    const inspectionPoints = [
        {
            id: "front-bumper",
            title: "Front Bumper",
            subtitle: "Impact zone",
            color: "#ff514f",
            view: "front",
            body:
                "Inspect the front bumper for cracks, deformation, paint transfer, broken mounting points and panel misalignment.",
            position: [-2.42, 0.18, 0]
        },
        {
            id: "front-fender",
            title: "Front Right Fender",
            subtitle: "Body panel",
            color: "#ffb52e",
            view: "side",
            body:
                "Inspect the fender edge, wheel arch and panel gap for dents, bending, paint damage or deformation.",
            position: [-1.05, 0.56, -0.94]
        },
        {
            id: "headlight",
            title: "Headlight Area",
            subtitle: "Lighting assembly",
            color: "#4d9fff",
            view: "front",
            body:
                "Inspect the headlight lens, housing, mounting position and alignment for cracks or displacement.",
            position: [-2.32, 0.86, -0.62]
        }
    ];

    // ------------------------------------------------------------
    // Vehicle geometry
    // ------------------------------------------------------------

    const vehicle = {
        length: 4.9,
        width: 1.92,
        bodyHeight: 0.82,
        cabinHeight: 0.78,
        wheelRadius: 0.43,
        wheelWidth: 0.26
    };

    // ------------------------------------------------------------
    // Resize
    // ------------------------------------------------------------

    function resize() {
        const rect = stage.getBoundingClientRect();

        state.width = Math.max(320, rect.width);
        state.height = Math.max(360, rect.height);

        state.dpr = Math.min(window.devicePixelRatio || 1, 2);

        canvas.width = Math.floor(state.width * state.dpr);
        canvas.height = Math.floor(state.height * state.dpr);

        canvas.style.width = `${state.width}px`;
        canvas.style.height = `${state.height}px`;

        ctx.setTransform(
            state.dpr,
            0,
            0,
            state.dpr,
            0,
            0
        );
    }

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(stage);
    resize();

    // ------------------------------------------------------------
    // Math helpers
    // ------------------------------------------------------------

    function lerp(a, b, amount) {
        return a + (b - a) * amount;
    }

    function clamp(value, min, max) {
        return Math.max(min, Math.min(max, value));
    }

    function rotateY(point, angle) {
        const c = Math.cos(angle);
        const s = Math.sin(angle);

        return {
            x: point.x * c - point.z * s,
            y: point.y,
            z: point.x * s + point.z * c
        };
    }

    function rotateX(point, angle) {
        const c = Math.cos(angle);
        const s = Math.sin(angle);

        return {
            x: point.x,
            y: point.y * c - point.z * s,
            z: point.y * s + point.z * c
        };
    }

    function transformPoint(point) {
        let p = rotateY(point, state.yaw);
        p = rotateX(p, state.pitch);

        return p;
    }

    function project(point) {
        const p = transformPoint(point);

        const cameraDistance = 9.5;
        const perspective = cameraDistance /
            Math.max(1, cameraDistance - p.z);

        const scale =
            Math.min(state.width, state.height) *
            0.115 *
            state.zoom;

        return {
            x: state.width / 2 + p.x * scale * perspective,
            y: state.height / 2 - p.y * scale * perspective,
            z: p.z,
            scale: perspective
        };
    }

    function shadeColor(hex, amount) {
        const clean = hex.replace("#", "");

        const r = parseInt(clean.substring(0, 2), 16);
        const g = parseInt(clean.substring(2, 4), 16);
        const b = parseInt(clean.substring(4, 6), 16);

        const factor = amount;

        const nr = clamp(Math.round(r * factor), 0, 255);
        const ng = clamp(Math.round(g * factor), 0, 255);
        const nb = clamp(Math.round(b * factor), 0, 255);

        return `rgb(${nr}, ${ng}, ${nb})`;
    }

    // ------------------------------------------------------------
    // Drawing helpers
    // ------------------------------------------------------------

    function polygon(points, fill, stroke = null, lineWidth = 1) {
        if (!points.length) return;

        ctx.beginPath();
        ctx.moveTo(points[0].x, points[0].y);

        for (let i = 1; i < points.length; i++) {
            ctx.lineTo(points[i].x, points[i].y);
        }

        ctx.closePath();

        if (fill) {
            ctx.fillStyle = fill;
            ctx.fill();
        }

        if (stroke) {
            ctx.strokeStyle = stroke;
            ctx.lineWidth = lineWidth;
            ctx.stroke();
        }
    }

    function box(x, y, z, width, height, depth, color) {
        const x1 = x - width / 2;
        const x2 = x + width / 2;

        const y1 = y;
        const y2 = y + height;

        const z1 = z - depth / 2;
        const z2 = z + depth / 2;

        const vertices = [
            { x: x1, y: y1, z: z1 },
            { x: x2, y: y1, z: z1 },
            { x: x2, y: y2, z: z1 },
            { x: x1, y: y2, z: z1 },

            { x: x1, y: y1, z: z2 },
            { x: x2, y: y1, z: z2 },
            { x: x2, y: y2, z: z2 },
            { x: x1, y: y2, z: z2 }
        ];

        const faces = [
            {
                ids: [0, 1, 2, 3],
                shade: 0.84
            },
            {
                ids: [4, 7, 6, 5],
                shade: 1.12
            },
            {
                ids: [0, 4, 5, 1],
                shade: 0.72
            },
            {
                ids: [3, 2, 6, 7],
                shade: 0.98
            },
            {
                ids: [1, 5, 6, 2],
                shade: 1.04
            },
            {
                ids: [0, 3, 7, 4],
                shade: 0.62
            }
        ];

        const renderedFaces = faces.map(face => {
            const pts3 = face.ids.map(id => vertices[id]);
            const pts2 = pts3.map(project);

            const depth =
                pts2.reduce((sum, p) => sum + p.z, 0) /
                pts2.length;

            return {
                pts2,
                depth,
                shade: face.shade
            };
        });

        renderedFaces.sort((a, b) => a.depth - b.depth);

        renderedFaces.forEach(face => {
            polygon(
                face.pts2,
                shadeColor(color, face.shade),
                "rgba(255,255,255,0.08)",
                1
            );
        });
    }

    function wheel(x, z, rotation = 0) {
        const center = project({
            x,
            y: vehicle.wheelRadius,
            z
        });

        const scale =
            Math.min(state.width, state.height) *
            0.115 *
            state.zoom *
            center.scale;

        const radius = vehicle.wheelRadius * scale;

        ctx.save();

        ctx.translate(center.x, center.y);

        // Outer tyre
        ctx.beginPath();
        ctx.ellipse(
            0,
            0,
            radius * 0.55,
            radius,
            rotation,
            0,
            Math.PI * 2
        );

        ctx.fillStyle = "#080b11";
        ctx.fill();

        ctx.strokeStyle = "#313949";
        ctx.lineWidth = Math.max(1, radius * 0.045);
        ctx.stroke();

        // Rim
        ctx.beginPath();
        ctx.ellipse(
            0,
            0,
            radius * 0.30,
            radius * 0.56,
            rotation,
            0,
            Math.PI * 2
        );

        const rimGradient = ctx.createLinearGradient(
            -radius,
            -radius,
            radius,
            radius
        );

        rimGradient.addColorStop(0, "#d7dce6");
        rimGradient.addColorStop(0.45, "#6c7586");
        rimGradient.addColorStop(1, "#202632");

        ctx.fillStyle = rimGradient;
        ctx.fill();

        ctx.strokeStyle = "#e9edf4";
        ctx.lineWidth = Math.max(1, radius * 0.025);
        ctx.stroke();

        // Centre hub
        ctx.beginPath();
        ctx.arc(
            0,
            0,
            radius * 0.12,
            0,
            Math.PI * 2
        );

        ctx.fillStyle = "#aeb7c7";
        ctx.fill();

        // Spokes
        ctx.strokeStyle = "rgba(235,240,248,0.65)";
        ctx.lineWidth = Math.max(1, radius * 0.035);

        for (let i = 0; i < 5; i++) {
            const angle =
                rotation +
                (Math.PI * 2 * i) / 5;

            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.lineTo(
                Math.cos(angle) * radius * 0.28,
                Math.sin(angle) * radius * 0.52
            );
            ctx.stroke();
        }

        ctx.restore();
    }

    function windowPanel(points, fill) {
        polygon(
            points.map(project),
            fill,
            "rgba(170,205,255,0.28)",
            1
        );
    }

    // ------------------------------------------------------------
    // Background
    // ------------------------------------------------------------

    function drawBackground() {
        const gradient = ctx.createRadialGradient(
            state.width * 0.50,
            state.height * 0.38,
            20,
            state.width * 0.50,
            state.height * 0.50,
            Math.max(state.width, state.height) * 0.75
        );

        gradient.addColorStop(0, "#172237");
        gradient.addColorStop(0.45, "#0c1421");
        gradient.addColorStop(1, "#070b12");

        ctx.fillStyle = gradient;
        ctx.fillRect(
            0,
            0,
            state.width,
            state.height
        );

        // Soft spotlight
        const glow = ctx.createRadialGradient(
            state.width * 0.5,
            state.height * 0.44,
            0,
            state.width * 0.5,
            state.height * 0.44,
            state.width * 0.42
        );

        glow.addColorStop(
            0,
            "rgba(75,130,255,0.13)"
        );

        glow.addColorStop(
            1,
            "rgba(75,130,255,0)"
        );

        ctx.fillStyle = glow;
        ctx.fillRect(
            0,
            0,
            state.width,
            state.height
        );
    }

    // ------------------------------------------------------------
    // Ground
    // ------------------------------------------------------------

    function drawGround() {
        const groundY = state.height * 0.73;

        const shadow = ctx.createRadialGradient(
            state.width / 2,
            groundY,
            10,
            state.width / 2,
            groundY,
            state.width * 0.30
        );

        shadow.addColorStop(
            0,
            "rgba(0,0,0,0.55)"
        );

        shadow.addColorStop(
            1,
            "rgba(0,0,0,0)"
        );

        ctx.fillStyle = shadow;

        ctx.beginPath();
        ctx.ellipse(
            state.width / 2,
            groundY,
            state.width * 0.30,
            40,
            0,
            0,
            Math.PI * 2
        );

        ctx.fill();

        // Ground reflection
        ctx.strokeStyle = "rgba(90,135,210,0.09)";
        ctx.lineWidth = 1;

        for (let i = -6; i <= 6; i++) {
            const y =
                groundY +
                i * 12;

            ctx.beginPath();
            ctx.moveTo(
                state.width * 0.15,
                y
            );

            ctx.lineTo(
                state.width * 0.85,
                y
            );

            ctx.stroke();
        }
    }

    // ------------------------------------------------------------
    // Vehicle
    // ------------------------------------------------------------

    function drawVehicle() {
        const bodyColor = "#315c91";

        // Main lower body
        box(
            0,
            0.42,
            0,
            vehicle.length,
            vehicle.bodyHeight,
            vehicle.width,
            bodyColor
        );

        // Lower shadow section
        box(
            0,
            0.36,
            0,
            vehicle.length * 0.96,
            0.22,
            vehicle.width * 1.02,
            "#162338"
        );

        // Hood
        box(
            -1.42,
            0.99,
            0,
            1.45,
            0.20,
            1.73,
            "#3e6fa7"
        );

        // Rear trunk
        box(
            1.55,
            0.94,
            0,
            1.12,
            0.20,
            1.72,
            "#345e8e"
        );

        // Cabin
        box(
            0.18,
            1.00,
            0,
            2.22,
            0.70,
            1.60,
            "#284b71"
        );

        // Roof
        box(
            0.18,
            1.67,
            0,
            1.82,
            0.12,
            1.50,
            "#3d6590"
        );

        // Front windshield
        windowPanel([
            { x: -0.93, y: 1.08, z: -0.805 },
            { x: -0.62, y: 1.58, z: -0.805 },
            { x: 0.02, y: 1.58, z: -0.805 },
            { x: 0.02, y: 1.08, z: -0.805 }
        ], "rgba(66,111,160,0.55)");

        // Rear side glass
        windowPanel([
            { x: 0.08, y: 1.08, z: -0.805 },
            { x: 0.08, y: 1.58, z: -0.805 },
            { x: 0.92, y: 1.58, z: -0.805 },
            { x: 1.14, y: 1.08, z: -0.805 }
        ], "rgba(55,96,140,0.52)");

        // Far-side windows
        windowPanel([
            { x: -0.93, y: 1.08, z: 0.805 },
            { x: 0.02, y: 1.08, z: 0.805 },
            { x: 0.02, y: 1.58, z: 0.805 },
            { x: -0.62, y: 1.58, z: 0.805 }
        ], "rgba(38,68,102,0.45)");

        windowPanel([
            { x: 0.08, y: 1.08, z: 0.805 },
            { x: 1.14, y: 1.08, z: 0.805 },
            { x: 0.92, y: 1.58, z: 0.805 },
            { x: 0.08, y: 1.58, z: 0.805 }
        ], "rgba(35,64,96,0.45)");

        // Front grille
        const grille = project({
            x: -2.48,
            y: 0.67,
            z: 0
        });

        const grilleW =
            0.13 *
            Math.min(state.width, state.height) *
            0.115 *
            grille.scale;

        const grilleH =
            0.48 *
            Math.min(state.width, state.height) *
            0.115 *
            grille.scale;

        ctx.fillStyle = "#070b10";

        ctx.fillRect(
            grille.x - grilleW / 2,
            grille.y - grilleH / 2,
            grilleW,
            grilleH
        );

        ctx.strokeStyle = "#7d8798";
        ctx.lineWidth = 1;

        for (let i = 0; i < 6; i++) {
            const gx =
                grille.x -
                grilleW * 0.38 +
                (grilleW * 0.76 * i) / 5;

            ctx.beginPath();
            ctx.moveTo(gx, grille.y - grilleH * 0.42);
            ctx.lineTo(gx, grille.y + grilleH * 0.42);
            ctx.stroke();
        }

        // Headlights
        drawLight(-2.45, 0.88, -0.58, "#bde6ff");
        drawLight(-2.45, 0.88, 0.58, "#bde6ff");

        // Rear lights
        drawLight(2.47, 0.84, -0.58, "#ff4e5a");
        drawLight(2.47, 0.84, 0.58, "#ff4e5a");

        // Side mirrors
        drawMirror(-0.58, -0.98);
        drawMirror(-0.58, 0.98);

        // Wheels
        wheel(-1.48, -1.00, 0);
        wheel(-1.48, 1.00, 0);
        wheel(1.46, -1.00, 0);
        wheel(1.46, 1.00, 0);

        // Door lines
        drawDoorLines();

        // Side highlight
        drawHighlight();

        // Roof reflection
        drawRoofReflection();
    }

    function drawLight(x, y, z, color) {
        const p = project({ x, y, z });

        const radius =
            Math.min(state.width, state.height) *
            0.115 *
            p.scale *
            0.17;

        const glow = ctx.createRadialGradient(
            p.x,
            p.y,
            0,
            p.x,
            p.y,
            radius * 3
        );

        glow.addColorStop(
            0,
            color.replace(")", ", 0.75)")
        );

        glow.addColorStop(
            1,
            "rgba(100,170,255,0)"
        );

        ctx.fillStyle = glow;

        ctx.beginPath();
        ctx.arc(
            p.x,
            p.y,
            radius * 3,
            0,
            Math.PI * 2
        );

        ctx.fill();

        ctx.fillStyle = color;

        ctx.beginPath();
        ctx.ellipse(
            p.x,
            p.y,
            radius * 0.55,
            radius * 0.30,
            0,
            0,
            Math.PI * 2
        );

        ctx.fill();
    }

    function drawMirror(x, z) {
        const p = project({
            x,
            y: 1.12,
            z
        });

        const w =
            Math.min(state.width, state.height) *
            0.115 *
            p.scale *
            0.18;

        const h =
            Math.min(state.width, state.height) *
            0.115 *
            p.scale *
            0.10;

        ctx.fillStyle = "#111923";

        ctx.beginPath();
        ctx.ellipse(
            p.x,
            p.y,
            w,
            h,
            0,
            0,
            Math.PI * 2
        );

        ctx.fill();

        ctx.strokeStyle = "#637188";
        ctx.stroke();
    }

    function drawDoorLines() {
        const lines = [
            [
                { x: -0.72, y: 0.50, z: -0.968 },
                { x: -0.72, y: 1.08, z: -0.968 }
            ],
            [
                { x: 0.30, y: 0.50, z: -0.968 },
                { x: 0.30, y: 1.08, z: -0.968 }
            ],
            [
                { x: 1.13, y: 0.50, z: -0.968 },
                { x: 1.13, y: 1.04, z: -0.968 }
            ]
        ];

        ctx.strokeStyle = "rgba(7,15,27,0.65)";
        ctx.lineWidth = 1;

        lines.forEach(line => {
            const a = project(line[0]);
            const b = project(line[1]);

            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
        });
    }

    function drawHighlight() {
        const a = project({
            x: -1.65,
            y: 1.02,
            z: -0.975
        });

        const b = project({
            x: 1.72,
            y: 1.02,
            z: -0.975
        });

        const gradient = ctx.createLinearGradient(
            a.x,
            a.y,
            b.x,
            b.y
        );

        gradient.addColorStop(
            0,
            "rgba(255,255,255,0)"
        );

        gradient.addColorStop(
            0.5,
            "rgba(190,225,255,0.22)"
        );

        gradient.addColorStop(
            1,
            "rgba(255,255,255,0)"
        );

        ctx.strokeStyle = gradient;
        ctx.lineWidth = 2;

        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
    }

    function drawRoofReflection() {
        const a = project({
            x: -0.55,
            y: 1.76,
            z: -0.70
        });

        const b = project({
            x: 0.65,
            y: 1.76,
            z: -0.70
        });

        ctx.strokeStyle = "rgba(210,230,255,0.20)";
        ctx.lineWidth = 3;

        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
    }

    // ------------------------------------------------------------
    // Hotspots
    // ------------------------------------------------------------

    function drawHotspots() {
        inspectionPoints.forEach((point, index) => {
            const p = project({
                x: point.position[0],
                y: point.position[1],
                z: point.position[2]
            });

            const pulse =
                1 +
                Math.sin(performance.now() * 0.004 + index) *
                0.10;

            const radius =
                7 *
                pulse *
                Math.max(0.75, p.scale);

            // Connector line
            ctx.strokeStyle =
                point.color === "#ff514f"
                    ? "rgba(255,81,79,0.40)"
                    : point.color === "#ffb52e"
                        ? "rgba(255,181,46,0.35)"
                        : "rgba(77,159,255,0.35)";

            ctx.lineWidth = 1;

            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(
                p.x,
                p.y - 32
            );
            ctx.stroke();

            // Glow
            const glow = ctx.createRadialGradient(
                p.x,
                p.y,
                0,
                p.x,
                p.y,
                radius * 3
            );

            glow.addColorStop(
                0,
                point.color
            );

            glow.addColorStop(
                1,
                "rgba(0,0,0,0)"
            );

            ctx.fillStyle = glow;

            ctx.beginPath();
            ctx.arc(
                p.x,
                p.y,
                radius * 3,
                0,
                Math.PI * 2
            );

            ctx.fill();

            // Outer ring
            ctx.strokeStyle = point.color;
            ctx.lineWidth = 2;

            ctx.beginPath();
            ctx.arc(
                p.x,
                p.y,
                radius + 4,
                0,
                Math.PI * 2
            );

            ctx.stroke();

            // Core
            ctx.fillStyle = point.color;

            ctx.beginPath();
            ctx.arc(
                p.x,
                p.y,
                radius,
                0,
                Math.PI * 2
            );

            ctx.fill();

            // Selected ring
            if (state.selectedPoint === point.id) {
                ctx.strokeStyle = "#ffffff";
                ctx.lineWidth = 2;

                ctx.beginPath();
                ctx.arc(
                    p.x,
                    p.y,
                    radius + 9,
                    0,
                    Math.PI * 2
                );

                ctx.stroke();
            }
        });
    }

    // ------------------------------------------------------------
    // HUD
    // ------------------------------------------------------------

    function drawHUD() {
        ctx.save();

        ctx.font = "600 10px Arial, sans-serif";
        ctx.fillStyle = "rgba(150,174,211,0.75)";
        ctx.letterSpacing = "1px";

        ctx.fillText(
            "AIM002 / VEHICLE INSPECTION",
            20,
            25
        );

        ctx.font = "500 9px Arial, sans-serif";
        ctx.fillStyle = "rgba(119,144,182,0.60)";

        ctx.fillText(
            "DRAG TO ROTATE  •  SCROLL TO ZOOM",
            20,
            state.height - 18
        );

        ctx.restore();
    }

    // ------------------------------------------------------------
    // Main render
    // ------------------------------------------------------------

    function render() {
        ctx.clearRect(
            0,
            0,
            state.width,
            state.height
        );

        drawBackground();
        drawGround();
        drawVehicle();
        drawHotspots();
        drawHUD();
    }

    // ------------------------------------------------------------
    // Animation
    // ------------------------------------------------------------

    let lastTime = performance.now();

    function animate(now) {
        const delta = Math.min(
            0.05,
            (now - lastTime) / 1000
        );

        lastTime = now;

        if (state.autoRotate && !state.dragging) {
            state.targetYaw += delta * 0.22;
        }

        state.yaw = lerp(
            state.yaw,
            state.targetYaw,
            0.08
        );

        state.pitch = lerp(
            state.pitch,
            state.targetPitch,
            0.08
        );

        state.zoom = lerp(
            state.zoom,
            state.targetZoom,
            0.08
        );

        render();

        requestAnimationFrame(animate);
    }

    // ------------------------------------------------------------
    // Pointer interaction
    // ------------------------------------------------------------

    canvas.addEventListener(
        "pointerdown",
        event => {
            state.dragging = true;

            state.pointerX = event.clientX;
            state.pointerY = event.clientY;

            canvas.setPointerCapture(event.pointerId);

            canvas.style.cursor = "grabbing";
        }
    );

    canvas.addEventListener(
        "pointermove",
        event => {
            if (!state.dragging) return;

            const dx =
                event.clientX -
                state.pointerX;

            const dy =
                event.clientY -
                state.pointerY;

            state.pointerX = event.clientX;
            state.pointerY = event.clientY;

            state.targetYaw += dx * 0.008;
            state.targetPitch += dy * 0.005;

            state.targetPitch = clamp(
                state.targetPitch,
                -0.45,
                1.15
            );
        }
    );

    function stopDragging() {
        state.dragging = false;
        canvas.style.cursor = "grab";
    }

    canvas.addEventListener(
        "pointerup",
        stopDragging
    );

    canvas.addEventListener(
        "pointercancel",
        stopDragging
    );

    canvas.addEventListener(
        "pointerleave",
        () => {
            if (state.dragging) {
                state.dragging = false;
                canvas.style.cursor = "grab";
            }
        }
    );

    canvas.addEventListener(
        "wheel",
        event => {
            event.preventDefault();

            const direction =
                event.deltaY > 0 ? -1 : 1;

            state.targetZoom +=
                direction * 0.08;

            state.targetZoom = clamp(
                state.targetZoom,
                0.72,
                1.55
            );
        },
        { passive: false }
    );

    canvas.addEventListener(
        "click",
        event => {
            const rect =
                canvas.getBoundingClientRect();

            const mouseX =
                event.clientX - rect.left;

            const mouseY =
                event.clientY - rect.top;

            let closest = null;
            let closestDistance = Infinity;

            inspectionPoints.forEach(point => {
                const p = project({
                    x: point.position[0],
                    y: point.position[1],
                    z: point.position[2]
                });

                const distance =
                    Math.hypot(
                        mouseX - p.x,
                        mouseY - p.y
                    );

                if (
                    distance < 30 &&
                    distance < closestDistance
                ) {
                    closest = point;
                    closestDistance = distance;
                }
            });

            if (closest) {
                selectInspectionPoint(closest);
            }
        }
    );

    canvas.style.cursor = "grab";

    // ------------------------------------------------------------
    // Camera controls
    // ------------------------------------------------------------

    function setView(viewName) {
        const view = views[viewName];

        if (!view) return;

        state.targetYaw = view.yaw;
        state.targetPitch = view.pitch;
        state.targetZoom = view.zoom;

        const label =
            stage.querySelector(".vehicle-camera-label");

        if (label) {
            label.textContent =
                `${viewName.toUpperCase()} VIEW`;
        }

        document
            .querySelectorAll("[data-view]")
            .forEach(button => {
                button.classList.toggle(
                    "active",
                    button.dataset.view === viewName
                );
            });
    }

    document
        .querySelectorAll("[data-view]")
        .forEach(button => {
            button.addEventListener(
                "click",
                () => {
                    setView(button.dataset.view);
                }
            );
        });

    // ------------------------------------------------------------
    // Auto rotation button
    // ------------------------------------------------------------

    const rotateButton =
        document.querySelector("[data-toggle-rotate]");

    if (rotateButton) {
        rotateButton.setAttribute(
            "aria-pressed",
            String(state.autoRotate)
        );

        rotateButton.addEventListener(
            "click",
            () => {
                state.autoRotate =
                    !state.autoRotate;

                rotateButton.classList.toggle(
                    "active",
                    state.autoRotate
                );

                rotateButton.setAttribute(
                    "aria-pressed",
                    String(state.autoRotate)
                );
            }
        );
    }

    // ------------------------------------------------------------
    // Inspection sidebar
    // ------------------------------------------------------------

    function selectInspectionPoint(point) {
        state.selectedPoint = point.id;

        const detail =
            document.querySelector("[data-damage-detail]");

        if (detail) {
            detail.innerHTML = `
                <div class="selected-area-filled">
                    <div
                        class="selected-area-color"
                        style="--area-color:${point.color};"
                    ></div>

                    <div class="selected-area-heading">
                        <strong>${escapeHTML(point.title)}</strong>
                        <span>${escapeHTML(point.subtitle)}</span>
                    </div>

                    <p>${escapeHTML(point.body)}</p>

                    <button
                        type="button"
                        class="selected-area-view"
                        data-selected-view="${point.view}"
                    >
                        Inspect ${escapeHTML(point.view)} view →
                    </button>
                </div>
            `;

            const viewButton =
                detail.querySelector(
                    "[data-selected-view]"
                );

            if (viewButton) {
                viewButton.addEventListener(
                    "click",
                    () => {
                        setView(point.view);
                    }
                );
            }
        }

        document
            .querySelectorAll("[data-damage-select]")
            .forEach(button => {
                button.classList.toggle(
                    "active",
                    button.dataset.title === point.title
                );
            });
    }

    document
        .querySelectorAll("[data-damage-select]")
        .forEach(button => {
            button.addEventListener(
                "click",
                () => {
                    const point =
                        inspectionPoints.find(
                            item =>
                                item.title ===
                                button.dataset.title
                        );

                    if (!point) return;

                    selectInspectionPoint(point);

                    setView(point.view);
                }
            );
        });

    // ------------------------------------------------------------
    // Utility
    // ------------------------------------------------------------

    function escapeHTML(value) {
        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    // ------------------------------------------------------------
    // Small native canvas styling
    // ------------------------------------------------------------

    const style = document.createElement("style");

    style.textContent = `
        #vehicle3dStage {
            position: relative;
            overflow: hidden;
        }

        .aim002-native-vehicle-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            touch-action: none;
            user-select: none;
        }

        .vehicle-camera-label {
            z-index: 5;
            pointer-events: none;
        }

        .vehicle-orientation {
            z-index: 5;
            pointer-events: none;
        }
    `;

    document.head.appendChild(style);

    // ------------------------------------------------------------
    // Initial state
    // ------------------------------------------------------------

    const loadingText =
        stage.querySelector(".vehicle-loading");

    if (loadingText) {
        loadingText.remove();
    }

    const status =
        document.querySelector("[data-vehicle-status]");

    if (status) {
        status.innerHTML = `
            <span class="viewer-status-dot"></span>
            3D VIEW READY
        `;
    }

    setView("home");

    // Initial render immediately.
    resize();
    render();

    // Start animation.
    requestAnimationFrame(animate);

    console.log(
        "AIM002: Lightweight vehicle inspection viewer loaded."
    );
})();