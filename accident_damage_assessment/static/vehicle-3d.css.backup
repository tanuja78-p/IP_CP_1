.vehicle-inspection-section{margin-top:22px;padding:26px;border-radius:22px;border:1px solid #29334b;background:linear-gradient(145deg,#0d1420,#090d14);box-shadow:0 20px 60px #0005}.vehicle-section-header{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:18px}.vehicle-section-header h2{font:800 25px Manrope;margin:7px 0 5px}.vehicle-section-header p{color:#7f8ba0;font-size:11px;margin:0}.viewer-status{display:flex;align-items:center;gap:8px;border:1px solid #2d3850;border-radius:999px;padding:8px 11px;color:#9ba7bb;font-size:9px;white-space:nowrap}.viewer-status-dot{width:7px;height:7px;border-radius:50%;background:#55d6a0;box-shadow:0 0 12px #55d6a0}.vehicle-inspection-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:16px}.vehicle-stage-card,.inspection-panel{border:1px solid #273144;border-radius:15px;background:#111722}.vehicle-stage-topbar{display:flex;justify-content:space-between;padding:12px 15px;border-bottom:1px solid #252e40}.stage-label,.stage-hint{font-size:8px;letter-spacing:1.2px;color:#7f8ba1}.vehicle-3d-stage{height:520px;position:relative;overflow:hidden;background:radial-gradient(circle at 50% 45%,#273653,#0a0f17 65%)}.vehicle-3d-stage canvas{display:block;width:100%;height:100%}.vehicle-loading{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:#8c98ad;font-size:10px;pointer-events:none;z-index:2;background:linear-gradient(#0a0f1788,#0a0f1733)}.vehicle-loading-spinner{width:24px;height:24px;border:2px solid #35415a;border-top-color:#7190ff;border-radius:50%;animation:vehicleSpin .8s linear infinite}.vehicle-camera-label{position:absolute;top:12px;left:12px;padding:6px 8px;border:1px solid #34415c;border-radius:7px;background:#0b1019bb;color:#a7b4cb;font-size:8px;letter-spacing:1px;z-index:3}.vehicle-orientation{position:absolute;right:12px;bottom:12px;display:flex;gap:5px;z-index:3}.vehicle-orientation span{padding:5px 7px;border:1px solid #303c53;background:#0b1019bb;color:#75839a;border-radius:5px;font-size:7px}.vehicle-controls{display:flex;gap:7px;flex-wrap:wrap;padding:12px}.vehicle-control{border:1px solid #303b50;background:#171e2a;color:#9da9bc;border-radius:8px;padding:8px 11px;font-size:9px}.vehicle-control:hover,.vehicle-control.active{border-color:#657dff;background:#26335b;color:#dce3ff}.inspection-sidebar{display:grid;gap:12px;align-content:start}.inspection-panel{padding:15px}.inspection-panel-header{display:flex;justify-content:space-between;align-items:flex-start}.inspection-panel h3{font:700 14px Manrope;margin:6px 0 0}.inspection-count{padding:5px 7px;border-radius:7px;background:#26325a;color:#b6c4ff;font-size:9px}.inspection-point-list{display:grid;gap:7px;margin-top:13px}.inspection-point{width:100%;display:flex;align-items:center;gap:9px;text-align:left;padding:11px;border:1px solid #273143;background:#141a24;border-radius:10px;color:#e2e7f0}.inspection-point:hover{border-color:#5369bd;transform:translateX(3px)}.inspection-dot,.legend-dot{width:9px;height:9px;border-radius:50%;background:var(--dot,#ff514f);box-shadow:0 0 0 4px #ffffff08;flex:none}.inspection-point-content{min-width:0;flex:1}.inspection-point-content strong,.inspection-point-content small{display:block}.inspection-point-content strong{font-size:10px}.inspection-point-content small{font-size:8px;color:#737f94;margin-top:3px}.inspection-arrow{color:#7285bc}.selected-area{margin-top:10px;min-height:120px}.selected-area-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:120px;gap:6px;color:#728096}.selected-area-empty strong{font-size:10px;color:#aeb8ca}.selected-area-empty span{font-size:9px;line-height:1.5}.selected-area-icon{width:32px;height:32px;display:grid;place-items:center;border-radius:9px;background:#1e2740;color:#8ea3ff;font-size:20px}.selected-area-filled{padding:13px;border-radius:10px;background:#151d2b;border:1px solid #303c55}.selected-area-filled h4{margin:0 0 6px;font:700 13px Manrope}.selected-area-filled p{margin:0;color:#8e9ab0;font-size:9px;line-height:1.6}.legend-row{display:flex;align-items:center;gap:8px;color:#8d99ad;font-size:9px;margin-top:9px}.legend-dot.red{background:#ff514f}.legend-dot.orange{background:#ffb52e}.legend-dot.blue{background:#4d9fff}.vehicle-disclaimer{display:flex;gap:10px;margin-top:14px;padding:12px 14px;border:1px solid #29354a;border-radius:10px;background:#101722;color:#77849a;font-size:9px;line-height:1.6}.vehicle-disclaimer span{color:#86a0ff}.vehicle-disclaimer p{margin:0}@keyframes vehicleSpin{to{transform:rotate(360deg)}}@media(max-width:900px){.vehicle-inspection-layout{grid-template-columns:1fr}.vehicle-3d-stage{height:420px}}@media(max-width:600px){.vehicle-section-header{flex-direction:column}.vehicle-3d-stage{height:330px}.vehicle-controls{display:grid;grid-template-columns:repeat(3,1fr)}.vehicle-control{padding:8px 4px}.vehicle-disclaimer{font-size:8px}}
